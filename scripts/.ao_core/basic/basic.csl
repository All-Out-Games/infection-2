min :: proc(a: int, b: int) -> int #intrinsic "min_s64";
min :: proc(a: f32, b: f32) -> f32 #intrinsic "min_f32";
min :: proc(a: f64, b: f64) -> f64 #intrinsic "min_f64";
max :: proc(a: int, b: int) -> int #intrinsic "max_s64";
max :: proc(a: f32, b: f32) -> f32 #intrinsic "max_f32";
